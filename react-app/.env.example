# Vite reads .env files from this directory (the Vite root), not from precis_web/.
# Copy to react-app/.env for local overrides. Only VITE_-prefixed variables are
# exposed to the browser bundle, and their values are inlined at build time --
# never put a secret in here.

# Base URL for API calls. Leave unset on Vercel so the browser uses same-origin
# /api/* routes; the local dev server defaults to http://localhost:5000.
# VITE_API_BASE_URL=http://localhost:5000

# Google Analytics 4 measurement ID, read by src/analytics.js. Unset falls back to
# the default ID in that file. Set it to an empty string to disable analytics for
# an environment -- do this for Vercel Preview, whose builds are production builds
# and would otherwise report into the same property.
# Analytics only loads in production builds, so `npm start` never reports.
# VITE_GA_MEASUREMENT_ID=G-SHZYRCMXJ8
