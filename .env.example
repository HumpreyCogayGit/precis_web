# Local Express API and Vercel Serverless API
# Use the pooled/external Postgres connection string supplied by your hosted DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional alternatives recognized by the API layer.
# POSTGRES_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# PGSSLMODE=require
# PG_POOL_MAX=5

# React app only. Leave unset on Vercel so requests use same-origin /api routes.
# For local CRA dev server, the default is http://localhost:5000.
# REACT_APP_API_BASE_URL=http://localhost:5000