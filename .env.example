# Local Express API and Vercel Serverless API
# Use the pooled Neon/Vercel Postgres connection string supplied by your hosted DB.
# Do not put real credentials in this example file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&sslmode=require"

# Optional alternatives recognized by the API layer.
# POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&sslmode=require"
# POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&connect_timeout=15&sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@UNPOOLED_HOST/DATABASE?sslmode=require"
# POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@UNPOOLED_HOST/DATABASE?channel_binding=require&sslmode=require"
# POSTGRES_HOST=HOST
# POSTGRES_USER=USER
# POSTGRES_PASSWORD=PASSWORD
# POSTGRES_DATABASE=DATABASE
# PGSSLMODE=require
# Optional provider CA bundle for verified database TLS. Store the PEM contents with
# newlines escaped as \n if your environment variable UI requires one line.
# PG_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# POSTGRES_CA_CERT is also recognized as an alternative.
# Do not set this in production unless your provider explicitly requires it for
# legacy/self-signed chains. Default production behavior verifies DB certificates.
# PG_SSL_ALLOW_UNAUTHORIZED=false
# Use a low pool size for serverless unless your provider gives you a pooled URL.
# PG_POOL_MAX=1

# Comma-separated origins allowed to call the local Express API from browsers.
# Development defaults to http://localhost:5173 and http://127.0.0.1:5173.
# Production defaults to no cross-origin browser access; leave unset for same-origin
# Vercel /api calls or set exact trusted origins if you deploy a separate frontend.
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# Image proxy safeguards.
# IMAGE_PROXY_TIMEOUT_MS=5000
# IMAGE_PROXY_MAX_BYTES=5242880
# Comma-separated hostname allowlist. Required in production; development may leave
# it unset to allow non-private public http(s) image hosts while testing.
# Include only hosts you expect article images to load from.
IMAGE_PROXY_ALLOWED_HOSTS=images.example.com,cdn.example.com

# React/Vite app only. Leave unset on Vercel so requests use same-origin /api routes.
# For local Vite dev server, the default is http://localhost:5000.
# VITE_API_BASE_URL=http://localhost:5000

# Google Analytics 4 measurement ID, read by react-app/src/analytics.js and inlined
# at build time. Unset falls back to the default ID in that file; set it to an empty
# string to disable analytics for an environment (do this for Vercel Preview, whose
# builds are production builds and would otherwise report into the same property).
# NOTE: Vite reads .env from react-app/, not from this directory, so for a LOCAL
# build this belongs in react-app/.env (see react-app/.env.example). On Vercel it
# works as a project variable either way, because `npm run build` runs the Vite
# build as a child process that inherits the environment.
# Analytics only loads in production builds, so local `npm start` never reports.
# VITE_GA_MEASUREMENT_ID=G-SHZYRCMXJ8